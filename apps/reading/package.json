{
  "name": "antiek-reading",
  "private": true,
  "version": "0.1.0",
  "description": "Antiek reading surface — Loop 2 wrestling UI. The TS side of the polyglot seam (architecture_notes §11).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check": "npm run build && tsx scripts/check_bundle.ts",
    "bench:pdf-panel": "tsx scripts/bench_pdf_panel.ts",
    "e2e": "npm run build-storybook && playwright test",
    "a11y:audit": "npm run build-storybook && tsx scripts/a11y_audit.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint:tokens": "tsx scripts/lint_tokens.ts",
    "lint:tokens:update": "tsx scripts/lint_tokens.ts --update",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "visualtest": "npm run build-storybook && lost-pixel",
    "visualtest:update": "npm run build-storybook && lost-pixel update",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "framer-motion": "^12.40.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.3",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "lost-pixel": "^3.22.0",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "storybook": "^8.4.7",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.7"
  }
}
