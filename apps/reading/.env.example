# apps/reading/.env.example
#
# Copy to `.env.local` (gitignored) and customise.
# Loaded by Vite at build time.

# UI cutover flag (S12 + SPR-08).
#
# Default: v2 — the redesigned shell. As of SPR-08, v2 IS the
# four-workflow IA: NavRail (Research · Read · Write · Speak) + the
# Topbar scene chrome + the workflow-scoped content tree + the products
# launcher (src/AppShell.tsx, mounted by src/App.tsx).
#
# Rollback: set VITE_ANTIEK_UI=v1 in the production env and redeploy.
# v1 renders src/AppLegacy.tsx — the intentionally-minimal pre-redesign
# chrome (Research + Wrestle + Login only), a tiny target if the new
# shell breaks in prod. The flag is the reversible-change discipline:
# one env var + a Cloudflare Pages redeploy, no code change.
#
# The cutover is intentionally kept behind the flag: a four-workflow
# rail over mostly-stubbed Read/Write/Speak is a large surface change,
# and the rollback is cheap insurance. Retiring v1 + the flag is a
# later operator decision once the new IA is proven in prod (see
# src/shell/CONFORMANCE.md "Cutover + rollback").
VITE_ANTIEK_UI=v2

# Optional: override the substrate base URL when running the dev
# server against a non-localhost backend.
# VITE_API_BASE=http://localhost:8000

# Optional: enable Storybook addon-a11y on Storybook bootup.
# (No-op for dev / build server.)
# VITE_STORYBOOK_A11Y=1
