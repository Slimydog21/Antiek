# Cloudflare Pages response headers for antiek.ai (the SPA host).
#
# Verified live 2026-09-26 before this file existed:
#   Strict-Transport-Security  absent on this host
#   Content-Security-Policy    absent on this host
#   X-Frame-Options            absent on this host (API host had it)
#   Referrer-Policy            present (strict-origin-when-cross-origin)
#   X-Content-Type-Options     present (nosniff)
#   Permissions-Policy         absent on this host
#
# The two hosts previously disagreed about which headers exist at all.
# This file and infrastructure/ansible/templates/Caddyfile.j2 now state the
# same policy on both surfaces. Cloudflare Pages copies this file from the
# build output (apps/reading/public/ → dist/) and applies it at the edge.
#
# Full resource CSP (2026-09-27). The string is kept byte-identical to
# the Content-Security-Policy value in
# infrastructure/ansible/templates/Caddyfile.j2 (tests/test_caddy_csp.py
# asserts that) so the two hosts cannot drift; the annotated rationale
# for every source lives there.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' https://*.posthog.com https://*.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.antiek.ai wss://api.antiek.ai https://*.posthog.com https://*.i.posthog.com; media-src 'self' blob:; worker-src 'self'; frame-src 'self' blob:

# Hashed Vite bundles are content-addressed; immutable caching is safe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must never be cached — it is the SPA shell that boots the app.
/index.html
  Cache-Control: no-store, must-revalidate
