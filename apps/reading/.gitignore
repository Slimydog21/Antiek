node_modules/
dist/
.vite/
storybook-static/
*.log
.DS_Store

# TypeScript incremental build cache — a per-machine artifact (tsc -b),
# never meant to be committed. One leaked into a prior commit; this stops it.
*.tsbuildinfo

# Lost-Pixel — baseline IS checked in; current + diff are not.
.lostpixel/current/
.lostpixel/diff/
test-results/
playwright-report/

# node_modules is a SYMLINK in dev worktrees; the trailing-slash
# `node_modules/` pattern above matches a real dir but NOT a symlink to
# one, so match it bare too (keeps `git add -A` from staging the link).
node_modules

# Playwright debug screenshot output (page.screenshot path=), not a baseline
e2e/**/.artifacts/
