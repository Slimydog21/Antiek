secrets/

# SPR-08 BYOK on-disk artifacts. The credential store (runtime/byok/store.py)
# persists an encrypted blob + a separate 0600 master key; the pipeline config
# (runtime/byok/pipelines.py) persists non-secret JSON. None of these are source
# code. Explicitly ignore them so a debug/ingest run that drops them into the
# (committed) runtime/byok/ package directory can never be swept into a commit by
# `git add -A`. The generic secrets/ and .env rules do NOT match these paths.
# (The default key path is also covered by a 0600 file outside-the-tree env
# override — ANTIEK_BYOK_KEY_FILE / ANTIEK_BYOK_ARTIFACT — but these rules guard
# the in-tree defaults.)
runtime/byok/credentials.enc
runtime/byok/*.enc
runtime/byok/byok_master.key
runtime/byok/*.key
runtime/byok/pipelines.json

# Notebook artifacts
.ipynb_checkpoints/

# Logs
*.log
logs/

# Node / TypeScript (apps/reading has its own .gitignore but belt-and-braces)
node_modules/
.next/
*.tsbuildinfo

# Operator's local research artifacts — corpus + per-investigation
# scratch dirs that the substrate writes. NOT source code; should not
# be in version control. Anchored to top-level so it doesn't also
# catch interfaces/research/ (the substrate API package).
/research/
docs/htmlspec/werner-ice-fishing-cursor/.caffenagent/

# /caffenagent + /conclave orchestration run-state (worktrees, ledgers,
# evidence). Pure scratch — regenerated per run, never source. Anchored
# loosely so it catches the dirs at any depth.
.caffenagent/
.conclave/
