{
  "dashboard": {
    "description": "Curated single-pane product health (built 2026-06-04): acquisition \u2192 activation \u2192 engagement \u2192 commerce \u2192 retention. Reuses existing insights; supersedes the duplicate Analytics-basics dashboards.",
    "name": "Antiek \u2014 North Star"
  },
  "insights": [
    {
      "name": "Deep research cascade workflow",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "dateRange": {
            "date_from": "-30d",
            "explicitDate": false
          },
          "filterTestAccounts": false,
          "funnelsFilter": {
            "breakdownAttributionType": "first_touch",
            "exclusions": [],
            "funnelOrderType": "ordered",
            "funnelStepReference": "total",
            "funnelVizType": "steps",
            "funnelWindowInterval": 14,
            "funnelWindowIntervalUnit": "day",
            "layout": "vertical",
            "showValuesOnSeries": false
          },
          "kind": "FunnelsQuery",
          "properties": [],
          "series": [
            {
              "event": "deep_research_cascade_created",
              "kind": "EventsNode",
              "name": "Cascade created"
            },
            {
              "event": "deep_research_plan_approved",
              "kind": "EventsNode",
              "name": "Plan approved"
            },
            {
              "event": "deep_research_cascade_launched",
              "kind": "EventsNode",
              "name": "Cascade launched"
            },
            {
              "event": "deep_research_canvas_opened",
              "kind": "EventsNode",
              "name": "Canvas opened"
            }
          ]
        }
      },
      "slug": "deep-research-cascade-workflow"
    },
    {
      "name": "Growth accounting",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "dateRange": {
            "date_from": "-30d",
            "explicitDate": false
          },
          "filterTestAccounts": false,
          "interval": "week",
          "kind": "LifecycleQuery",
          "lifecycleFilter": {
            "showLegend": false
          },
          "properties": [],
          "series": [
            {
              "event": "$pageview",
              "kind": "EventsNode",
              "name": "$pageview"
            }
          ]
        }
      },
      "slug": "growth-accounting"
    },
    {
      "name": "Key actions overview",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "dateRange": {
            "date_from": "-30d",
            "explicitDate": false
          },
          "filterTestAccounts": false,
          "interval": "day",
          "kind": "TrendsQuery",
          "properties": [],
          "series": [
            {
              "event": "investigation_started",
              "kind": "EventsNode",
              "math": "total",
              "name": "Investigation started"
            },
            {
              "event": "reading_research_spun",
              "kind": "EventsNode",
              "math": "total",
              "name": "Reading research spun"
            },
            {
              "event": "notebook_block_appended",
              "kind": "EventsNode",
              "math": "total",
              "name": "Notebook block added"
            },
            {
              "event": "notebook_block_deleted",
              "kind": "EventsNode",
              "math": "total",
              "name": "Notebook block deleted"
            },
            {
              "event": "speak_draft_assembled",
              "kind": "EventsNode",
              "math": "total",
              "name": "Story assembled"
            }
          ],
          "trendsFilter": {
            "aggregationAxisFormat": "numeric",
            "display": "ActionsLineGraph",
            "excludeBoxPlotOutliers": true,
            "hideWeekends": false,
            "resultCustomizationBy": "value",
            "showAlertThresholdLines": false,
            "showLegend": false,
            "showMultipleYAxes": false,
            "showPercentStackView": false,
            "showValuesOnSeries": false,
            "smoothingIntervals": 1,
            "stackBreakdownValues": false,
            "yAxisScaleType": "linear"
          },
          "version": 2
        }
      },
      "slug": "key-actions-overview"
    },
