{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cite_jump",
  "description": "Operator followed an inline citation to its source (forward or back).",
  "state": {
    "type": "object",
    "additionalProperties": false,
    "required": ["document_id"],
    "properties": {
      "document_id": { "type": "string" },
      "reading_mode": { "type": ["string", "null"] },
      "source_chunk_id": { "type": ["string", "null"] }
    }
  },
  "action": {
    "type": "object",
    "additionalProperties": false,
    "required": ["target_document_id", "direction"],
    "properties": {
      "target_document_id": { "type": "string" },
      "target_chunk_id": { "type": ["string", "null"] },
      "direction": { "type": "string" }
    }
  }
}
