{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "document_opened",
  "description": "Operator opened a document. Always the first behavior event in a per-document span.",
  "state": {
    "type": "object",
    "additionalProperties": false,
    "required": ["document_id"],
    "properties": {
      "document_id": { "type": "string" },
      "entry_route": { "type": ["string", "null"] },
      "referer_document_id": { "type": ["string", "null"] }
    }
  },
  "action": {
    "type": "object",
    "additionalProperties": false,
    "required": ["reading_mode"],
    "properties": {
      "reading_mode": { "type": "string" }
    }
  }
}
