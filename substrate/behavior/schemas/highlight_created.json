{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "highlight_created",
  "description": "Operator created a highlight on a passage. State = passage context the highlight was made in. Action = the highlight's location + colour/tag.",
  "state": {
    "type": "object",
    "additionalProperties": false,
    "required": ["document_id", "reading_mode"],
    "properties": {
      "document_id": { "type": "string" },
      "reading_mode": { "type": "string" },
      "scroll_depth_pct": { "type": ["number", "null"] },
      "chunk_id": { "type": ["string", "null"] },
      "session_elapsed_s": { "type": ["number", "null"] }
    }
  },
  "action": {
    "type": "object",
    "additionalProperties": false,
    "required": ["start_offset", "end_offset"],
    "properties": {
      "highlight_id": { "type": ["string", "null"] },
      "start_offset": { "type": "integer" },
      "end_offset": { "type": "integer" },
      "passage_text": { "type": ["string", "null"] },
      "color": { "type": ["string", "null"] },
      "tag": { "type": ["string", "null"] }
    }
  }
}
