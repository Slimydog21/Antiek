{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "document_closed",
  "description": "Operator left a document. Closes the per-document span; carries session metrics for the immediate-reward worker.",
  "state": {
    "type": "object",
    "additionalProperties": false,
    "required": ["document_id"],
    "properties": {
      "document_id": { "type": "string" },
      "reading_mode": { "type": ["string", "null"] },
      "scroll_depth_pct": { "type": ["number", "null"] }
    }
  },
  "action": {
    "type": "object",
    "additionalProperties": false,
    "required": ["session_duration_s"],
    "properties": {
      "session_duration_s": { "type": "number" },
      "highlights_created": { "type": ["integer", "null"] },
      "voice_notes_created": { "type": ["integer", "null"] }
    }
  }
}
