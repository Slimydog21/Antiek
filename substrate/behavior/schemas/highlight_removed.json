{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "highlight_removed",
  "description": "Operator removed an existing highlight.",
  "state": {
    "type": "object",
    "additionalProperties": false,
    "required": ["document_id"],
    "properties": {
      "document_id": { "type": "string" },
      "reading_mode": { "type": ["string", "null"] },
      "age_of_highlight_s": { "type": ["number", "null"] }
    }
  },
  "action": {
    "type": "object",
    "additionalProperties": false,
    "required": ["highlight_id"],
    "properties": {
      "highlight_id": { "type": "string" },
      "reason": { "type": ["string", "null"] }
    }
  }
}
