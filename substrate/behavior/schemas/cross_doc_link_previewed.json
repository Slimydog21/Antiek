{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cross_doc_link_previewed",
  "description": "Operator hovered a gutter pill and the CitePreview popover rendered. Sits between `surfaced` (system-initiated, 1 per highlight) and `clicked`/`dismissed` (terminal) in the funnel. Added in taxonomy v2 (2026-05-22).",
  "state": {
    "type": "object",
    "additionalProperties": false,
    "required": ["document_id"],
    "properties": {
      "document_id": { "type": "string" },
      "reading_mode": { "type": ["string", "null"] },
      "trigger_chunk_id": { "type": ["string", "null"] }
    }
  },
  "action": {
    "type": "object",
    "additionalProperties": false,
    "required": ["link_id", "target_document_id"],
    "properties": {
      "link_id": { "type": "string" },
      "target_document_id": { "type": "string" },
      "target_chunk_id": { "type": ["string", "null"] },
      "pill_position": { "type": ["integer", "null"] },
      "hover_duration_ms": { "type": ["integer", "null"] }
    }
  }
}
