{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cross_doc_link_dismissed",
  "description": "Operator dismissed a surfaced cross-document link (explicit negative signal).",
  "state": {
    "type": "object",
    "additionalProperties": false,
    "required": ["document_id", "link_id"],
    "properties": {
      "document_id": { "type": "string" },
      "link_id": { "type": "string" },
      "reading_mode": { "type": ["string", "null"] },
      "elapsed_since_surfaced_s": { "type": ["number", "null"] }
    }
  },
  "action": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "reason": { "type": ["string", "null"] }
    }
  }
}
