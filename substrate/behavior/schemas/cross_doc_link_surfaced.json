{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cross_doc_link_surfaced",
  "description": "Substrate surfaced a cross-document link in the gutter. This is a system-initiated event; the action describes WHAT was surfaced.",
  "state": {
    "type": "object",
    "additionalProperties": false,
    "required": ["document_id"],
    "properties": {
      "document_id": { "type": "string" },
      "reading_mode": { "type": ["string", "null"] },
      "trigger_chunk_id": { "type": ["string", "null"] }
    }
  },
  "action": {
    "type": "object",
    "additionalProperties": false,
    "required": ["link_id", "target_document_id"],
    "properties": {
      "link_id": { "type": "string" },
      "target_document_id": { "type": "string" },
      "target_chunk_id": { "type": ["string", "null"] },
      "surface_confidence": { "type": ["number", "null"] }
    }
  }
}
