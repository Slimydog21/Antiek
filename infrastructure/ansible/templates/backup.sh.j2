#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Antiek nightly backup.
#
# Snapshots DuckDB consistently (EXPORT DATABASE → directory of SQL +
# Parquet), rsyncs the append-only event log and knowledge-skills dir,
# tar+gzip, uploads to R2. Retention enforced in-script.
#
# Runs as root via cron at {{ backup_cron_hour }}:{{ backup_cron_minute }}
# UTC. Output to /var/log/antiek-backup.log.
#
# Why EXPORT DATABASE not just `cp antiek.duckdb backup.duckdb`?
#   Copying an open DuckDB file produces an inconsistent snapshot — the
#   write-ahead log and the main file can be out of sync. EXPORT DATABASE
#   takes a consistent transactional snapshot via DuckDB's own facility.
#   It writes a directory of Parquet shards + a load.sql script; IMPORT
#   DATABASE on the other end reconstitutes it.
#
# Why rsync the event log directly?
#   The event log is append-only .jsonl files. Reading them while the
#   substrate is still writing is safe (the substrate never rewrites or
#   truncates). A torn line at the tail is fine — IMPORTantly, the
#   substrate's startup re-reads the log idempotently.
#
# Verify-before-upload gate (R1, PR #714 review):
#   A backup that cannot IMPORT is not a backup. After EXPORT + schema
#   normalization the export is reconstituted into a scratch DuckDB inside
#   the staging dir and core-table row counts must match counts captured
#   from the source connection at EXPORT time. Any failure exits non-zero
#   BEFORE any rclone upload — the systemd journal / cron log is the alert
#   channel. On full success a freshness marker is written to
#   ${STATE_DIR}/backup_freshness.json (checked by tools/backup_freshness.py).
#
# Single-writer coordination (R2, PR #714 review):
#   antiek.service and antiek-continuous-research.service serialize all
#   DuckDB writes through an exclusive flock on the sidecar lock file
#   (runtime/db_lock.py: <db>.write.lock). The EXPORT below acquires that
#   same flock for the minimal window (connect + EXPORT + count capture)
#   so the snapshot can never race a writer. Bounded timeout: a hung
#   writer fails the backup loudly instead of blocking forever.
#
# This template is executed under test by tests/test_backup_deployed_script.py
# (rendered + run end-to-end against a scratch state dir). The two env
# overrides below (ANTIEK_BACKUP_STAGING_ROOT, ANTIEK_BACKUP_LOCK_TIMEOUT_S)
# exist for that harness; deployed defaults are unchanged when they are unset.

set -euo pipefail

readonly STATE_DIR="{{ antiek_state_dir }}"
readonly BUCKET="{{ backup_bucket_name }}"
readonly RETENTION_DAYS="{{ backup_retention_days }}"
readonly TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
readonly STAGING_ROOT="${ANTIEK_BACKUP_STAGING_ROOT:-/var/tmp}"
readonly STAGING="${STAGING_ROOT}/antiek-backup-${TIMESTAMP}"
readonly ARCHIVE="${STAGING_ROOT}/antiek-backup-${TIMESTAMP}.tar.gz"
# Portable UTC ISO stamp (+%Y-%m-%dT%H:%M:%SZ): GNU date's --iso-8601 is not
# portable to the BSD date the test harness may run under; output for UTC is
# equivalent.
readonly LOG_PREFIX="[$(date -u +%Y-%m-%dT%H:%M:%SZ)]"
readonly LOCK_TIMEOUT_S="${ANTIEK_BACKUP_LOCK_TIMEOUT_S:-180}"
readonly SCRIPT_VERSION="backup.sh/2026-07-11.verify-gate-1"

echo "${LOG_PREFIX} backup starting → r2:${BUCKET}/nightly/antiek-${TIMESTAMP}.tar.gz"

# Always clean staging on exit, even if something below fails. Prevents
# the staging root filling up if a partial backup is left behind.
cleanup() {
    rm -rf "${STAGING}" "${ARCHIVE}"
}
trap cleanup EXIT

mkdir -p "${STAGING}"
# DuckDB EXPORT below runs as the antiek user (file ownership of
# the snapshot matches the substrate's process); the staging dir
# was created by root and antiek can't write into it without an
# explicit chown. Chowning is cheaper than restructuring the
# privilege model. Cleanup trap above still removes regardless of
# owner. Fixed 2026-05-18 — was silently making nightly backups
# fail at the EXPORT step before the timer ever fired.
chown antiek:antiek "${STAGING}"

# ── 1. DuckDB consistent snapshot (under the single-writer flock) ─────────
# Run as the antiek user so file ownership matches — and, critically, so the
# sidecar lock file is created/opened as the same user the substrate's
# runtime/db_lock.py uses (a root-owned 0600 lock file would break the
# service's own lock acquisition). DuckDB CLI isn't in Ubuntu's apt repos as
# of 24.04, so we use the substrate's own venv — the duckdb Python package
# is pinned in pyproject.toml and works headless.
#
# The heredoc mirrors runtime/db_lock.py's flock protocol (same lock path
# <db>.write.lock, exclusive LOCK_EX acquired non-blocking in a poll loop
# with a deadline, pid + purpose stamped into the file) instead of importing
# runtime.db_lock, because (a) a stdin heredoc run from cron has no repo
# root on sys.path — the normalize step below already loads tools/ by file
# path for exactly this reason; and (b) db_lock.connect_write opens the DB
# for WRITE (and imports runtime.test_store_guard) — the backup must hold
# the writers' lock while opening READ-ONLY, a mode connect_write does not
# offer. Same lock file + same flock semantics ⇒ mutual exclusion with
# antiek.service and antiek-continuous-research.service is preserved.
# Lock window is minimal: connect + EXPORT + count capture only; normalize,
# verify, tar, and upload all run after release.
echo "${LOG_PREFIX} exporting DuckDB → ${STAGING}/duckdb (single-writer flock, timeout ${LOCK_TIMEOUT_S}s)"
sudo -u {{ antiek_user }} {{ antiek_install_dir }}/.venv/bin/python3 - <<PY
import errno
import fcntl
import json
import os
import sys
import time

import duckdb

db_path = "${STATE_DIR}/antiek.duckdb"
lock_path = db_path + ".write.lock"  # runtime/db_lock.py: _lock_path_for()
timeout_s = float("${LOCK_TIMEOUT_S}")

fd = os.open(lock_path, os.O_CREAT | os.O_WRONLY, 0o600)
deadline = time.monotonic() + timeout_s
while True:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except OSError as e:
        if e.errno not in (errno.EWOULDBLOCK, errno.EAGAIN):
            raise
        if time.monotonic() >= deadline:
            os.close(fd)
            sys.stderr.write(
                f"ERROR: backup: could not acquire DuckDB write lock {lock_path} "
                f"within {timeout_s:.0f}s - another writer is holding it; "
                "aborting backup (nothing exported, nothing uploaded)\n"
            )
            sys.exit(3)
        time.sleep(0.25)
try:
    # Stamp pid + purpose + ISO timestamp, same diagnostics convention as
    # runtime/db_lock.py (best-effort).
    try:
        os.ftruncate(fd, 0)
        stamp = "%d nightly_backup %s\n" % (
            os.getpid(), time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
        os.write(fd, stamp.encode())
    except OSError:
        pass
    con = duckdb.connect(db_path, read_only=True)
    try:
        con.execute("EXPORT DATABASE '${STAGING}/duckdb' (FORMAT PARQUET);")
        # Count capture happens on the SAME connection inside the SAME lock
        # window as the EXPORT, so the counts are exactly the snapshot's.
        counts = {
            t: con.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0]
            for t in ("documents", "chunks", "nodes")
        }
    finally:
        con.close()
finally:
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)

with open("${STAGING}/source_counts.json", "w") as f:
    json.dump(counts, f, indent=2)
print(f"  source row counts: {counts}")
PY

# ── 1b. Normalize EXPORT schema.sql (DuckDB self-ref-FK stray-comma bug) ──
# DuckDB EXPORT drops a self-referential FK but leaves a stray comma in
# schema.sql, which makes the inverse IMPORT DATABASE raise
# "syntax error at or near ','" on the real schema (edges.superseded_by,
# deliverable_sections.parent_section_id). The documented DR restore
# (runbooks/disaster-recovery.md) IS IMPORT DATABASE, so without this step
# the nightly backup is non-restorable. The normalizer is depth/string-
# aware and only removes commas that are never valid inside CREATE TABLE
# (see specs/antiek-data-durability + tests/test_backup_normalize_schema.py).
# Loaded by file path so the backup does not depend on the tools/ package
# layout or import-time side effects.
echo "${LOG_PREFIX} normalizing EXPORT schema.sql (self-ref-FK stray-comma fix)"
sudo -u {{ antiek_user }} {{ antiek_install_dir }}/.venv/bin/python3 - <<PY
import importlib.util
_p = "{{ antiek_install_dir }}/tools/backup_normalize_schema.py"
_spec = importlib.util.spec_from_file_location("backup_normalize_schema", _p)
_mod = importlib.util.module_from_spec(_spec); _spec.loader.exec_module(_mod)
_s = "${STAGING}/duckdb/schema.sql"
with open(_s) as _f: _raw = _f.read()
_fixed = _mod.normalize_exported_schema_sql(_raw)
if _fixed != _raw:
    with open(_s, "w") as _f: _f.write(_fixed)
    print("  schema.sql normalized (stray commas removed)")
else:
    print("  schema.sql already clean (no-op)")
PY

# ── 1c. Verify the export BEFORE anything is uploaded (R1 gate) ───────────
# IMPORT the normalized export into a scratch DuckDB inside the staging dir
# and require the core-table row counts to match the counts captured from
# the source connection at EXPORT time. Any failure → non-zero exit here,
# and set -e guarantees the rclone upload below never runs. The scratch DB
# is removed on success so it never bloats the archive; source_counts.json
# stays in staging deliberately (the archive carries its own manifest).
echo "${LOG_PREFIX} verifying export (IMPORT into scratch DB + row-count match) — gate before upload"
sudo -u {{ antiek_user }} {{ antiek_install_dir }}/.venv/bin/python3 - <<PY
import json
import os
import sys

import duckdb

with open("${STAGING}/source_counts.json") as f:
    expected = json.load(f)

scratch = "${STAGING}/verify-scratch.duckdb"
try:
    con = duckdb.connect(scratch)
    try:
        con.execute("IMPORT DATABASE '${STAGING}/duckdb'")
        actual = {
            t: con.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0]
            for t in expected
        }
    finally:
        con.close()
except Exception as e:
    sys.stderr.write(
        "ERROR: backup verify FAILED - export does not IMPORT cleanly "
        f"({type(e).__name__}: {e}); upload blocked\n"
    )
    sys.exit(4)

mismatches = {t: [expected[t], actual[t]] for t in expected if actual[t] != expected[t]}
if mismatches:
    sys.stderr.write(
        "ERROR: backup verify FAILED - row-count mismatch source vs import "
        f"(table: [source, imported]): {mismatches}; upload blocked\n"
    )
    sys.exit(4)

for leftover in (scratch, scratch + ".wal"):
    if os.path.exists(leftover):
        os.remove(leftover)
print(f"  verify OK - import succeeded, row counts match: {actual}")
PY

# ── 2. Event log (append-only, safe to rsync live) ────────────────────────
if [[ -d "${STATE_DIR}/research_events" ]]; then
    echo "${LOG_PREFIX} rsync event log"
    rsync -a "${STATE_DIR}/research_events/" "${STAGING}/research_events/"
else
    echo "${LOG_PREFIX} no event log directory yet; skipping"
fi

# ── 3. Knowledge skills (Phase 8 auto-patches accumulate here) ────────────
if [[ -d "${STATE_DIR}/knowledge_skills" ]]; then
    echo "${LOG_PREFIX} rsync knowledge_skills"
    rsync -a "${STATE_DIR}/knowledge_skills/" "${STAGING}/knowledge_skills/"
else
    echo "${LOG_PREFIX} no knowledge_skills directory yet; skipping"
fi

# ── 4. Compress + upload ──────────────────────────────────────────────────
echo "${LOG_PREFIX} tar+gzip"
tar -czf "${ARCHIVE}" -C "${STAGING_ROOT}" "$(basename "${STAGING}")"

readonly ARCHIVE_SIZE_HUMAN="$(du -h "${ARCHIVE}" | cut -f1)"
echo "${LOG_PREFIX} archive size: ${ARCHIVE_SIZE_HUMAN}"

echo "${LOG_PREFIX} uploading to R2"
rclone copyto "${ARCHIVE}" "r2:${BUCKET}/nightly/antiek-${TIMESTAMP}.tar.gz" \
    --config /etc/rclone/rclone.conf

# ── 5. Retention — prune old backups ──────────────────────────────────────
# `|| true` because a delete failure shouldn't fail the whole backup
# (more important to keep new backups landing than to keep old ones pruned).
echo "${LOG_PREFIX} pruning backups older than ${RETENTION_DAYS}d"
rclone delete --min-age "${RETENTION_DAYS}d" \
    "r2:${BUCKET}/nightly/" \
    --include "*.tar.gz" \
    --config /etc/rclone/rclone.conf \
    || echo "${LOG_PREFIX} WARN: retention prune failed (non-fatal)"

# ── 6. Freshness marker (only reachable on full success) ──────────────────
# tools/backup_freshness.py reads this marker; a marker older than its
# threshold (default 26h) — or missing — means nightly backups stopped
# landing. Written atomically (tmp + rename) as the antiek user so the
# substrate's own tooling can read/replace it.
readonly MARKER_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "${LOG_PREFIX} writing freshness marker → ${STATE_DIR}/backup_freshness.json"
sudo -u {{ antiek_user }} {{ antiek_install_dir }}/.venv/bin/python3 - <<PY
import json
import os

with open("${STAGING}/source_counts.json") as f:
    counts = json.load(f)
marker = {
    "completed_at": "${MARKER_TS}",
    "archive": "antiek-${TIMESTAMP}.tar.gz",
    "counts": counts,
    "script_version": "${SCRIPT_VERSION}",
}
tmp = "${STATE_DIR}/backup_freshness.json.tmp"
with open(tmp, "w") as f:
    json.dump(marker, f, indent=2)
    f.write("\n")
os.replace(tmp, "${STATE_DIR}/backup_freshness.json")
print("  marker written")
PY

echo "${LOG_PREFIX} backup complete"
