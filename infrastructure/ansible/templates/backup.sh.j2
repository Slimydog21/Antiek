#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Antiek nightly backup.
#
# Snapshots DuckDB consistently (EXPORT DATABASE → directory of SQL +
# Parquet), rsyncs the append-only event log and knowledge-skills dir,
# tar+gzip, uploads to R2, then reads the object back for verification.
#
# Runs as a bounded systemd oneshot at {{ backup_cron_hour }}:{{ backup_cron_minute }}
# UTC. Output is appended to /var/log/antiek-backup.log by the unit.
#
# Why EXPORT DATABASE not just `cp antiek.duckdb backup.duckdb`?
#   Copying an open DuckDB file produces an inconsistent snapshot — the
#   write-ahead log and the main file can be out of sync. EXPORT DATABASE
#   takes a consistent transactional snapshot via DuckDB's own facility.
#   It writes a directory of Parquet shards + a load.sql script; IMPORT
#   DATABASE on the other end reconstitutes it.
#
# Why rsync the event log directly?
#   The event log is append-only .jsonl files. Reading them while the
#   substrate is still writing is safe (the substrate never rewrites or
#   truncates). A torn line at the tail is fine — IMPORTantly, the
#   substrate's startup re-reads the log idempotently.
#
# Verify-before-upload gate (R1, PR #714 review):
#   A backup that cannot IMPORT is not a backup. After EXPORT + schema
#   normalization the export is reconstituted into a scratch DuckDB inside
#   the staging dir; its full table/count and restorable catalog manifests
#   must match the source captured at EXPORT time. Any failure exits non-zero
#   BEFORE any rclone upload. On full success a freshness marker is written to
#   ${STATE_DIR}/backup_freshness.json (checked by tools/backup_freshness.py).
#
# Single-writer coordination (R2, PR #714 review):
#   antiek.service and antiek-continuous-research.service serialize all
#   DuckDB writes through an exclusive flock on the sidecar lock file
#   (runtime/db_lock.py: <db>.write.lock). The EXPORT below acquires that
#   same flock for the minimal window (connect + EXPORT + count capture)
#   so the snapshot can never race a writer. Bounded timeout: a hung
#   writer fails the backup loudly instead of blocking forever.
#
# This template is executed under test by tests/test_backup_deployed_script.py
# (rendered + run end-to-end against a scratch state dir). Env overrides:
#   ANTIEK_BACKUP_STAGING_ROOT   — private staging root; test seam.
#   ANTIEK_BACKUP_JOB_LOCK       — whole-job flock path; test seam.
#   ANTIEK_BACKUP_LOCK_TIMEOUT_S — flock acquisition deadline (default 180s).
#   ANTIEK_BACKUP_ALLOW_EMPTY=1  — day-0 / fresh-install escape hatch: permit
#     certifying a backup whose core tables are ALL zero rows. Never the
#     default: an all-empty documents/chunks/nodes source on a production
#     store is a logical truncation, and an empty export count-matches its
#     own emptiness — it would verify, upload, and stamp a fresh marker,
#     certifying data loss. Deliberate and loud, set only for a legitimately
#     empty install.
# Deployed defaults are unchanged when all overrides are unset.
#
# Injection posture: the shell expands ${...} into the python heredocs below,
# i.e. env values become Python SOURCE TEXT. Every env-sourced value is
# therefore validated/normalized in bash first, so only provably-inert text
# (a bare 0/1, a plain number, a plain path) can reach a heredoc — a raw
# value containing a quote would otherwise terminate a Python string literal
# and execute as code. Jinja-rendered values (STATE_DIR etc.) are fixed at
# DEPLOY time by ansible group_vars, not runtime-injectable, and are not
# subject to this gate.

set -euo pipefail
umask 077

# Serialize the entire job, including verification, upload, and marker
# publication. The DuckDB write flock below protects only the source snapshot.
readonly STATE_DIR="{{ antiek_state_dir }}"
readonly BUCKET="{{ backup_bucket_name }}"
readonly TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"

# ── Env-seam validation (see injection posture above) ─────────────────────
# Regexes live in variables: bash 3.2 (macOS test hosts) mishandles some
# quoted/inline regex literals in [[ =~ ]].
_PATH_RE='^[A-Za-z0-9/._-]+$'
_NUM_RE='^[0-9]+(\.[0-9]+)?$'

readonly STAGING_ROOT="${ANTIEK_BACKUP_STAGING_ROOT:-/var/lib/antiek-backup}"
if [[ ! "${STAGING_ROOT}" =~ ${_PATH_RE} ]]; then
    echo "ERROR: backup: ANTIEK_BACKUP_STAGING_ROOT must match [A-Za-z0-9/._-]+ (it is interpolated into python source); refusing: ${STAGING_ROOT}" >&2
    exit 6
fi

readonly JOB_LOCK="${ANTIEK_BACKUP_JOB_LOCK:-/run/antiek-backup/job.lock}"
if [[ ! "${JOB_LOCK}" =~ ${_PATH_RE} ]]; then
    echo "ERROR: backup: ANTIEK_BACKUP_JOB_LOCK must match [A-Za-z0-9/._-]+; refusing: ${JOB_LOCK}" >&2
    exit 6
fi

exec 9>"${JOB_LOCK}"
if ! flock -n 9; then
    echo "ERROR: backup: another backup job is already running" >&2
    exit 7
fi

readonly LOCK_TIMEOUT_S="${ANTIEK_BACKUP_LOCK_TIMEOUT_S:-180}"
if [[ ! "${LOCK_TIMEOUT_S}" =~ ${_NUM_RE} ]]; then
    echo "ERROR: backup: ANTIEK_BACKUP_LOCK_TIMEOUT_S must be a plain non-negative number (it is interpolated into python source); refusing: ${LOCK_TIMEOUT_S}" >&2
    exit 6
fi

# Normalized to a provably-safe bare literal: ONLY the exact value "1" opts
# in; anything else (including hostile quote-bearing payloads) becomes "0",
# so the token reaching the heredoc is always the character 1 or 0. Captured
# in the shell (not read from os.environ inside the heredoc) because the
# heredoc python runs under `sudo -u`, which strips the caller's environment.
if [[ "${ANTIEK_BACKUP_ALLOW_EMPTY:-0}" == "1" ]]; then
    readonly ALLOW_EMPTY=1
else
    readonly ALLOW_EMPTY=0
fi

mkdir -p "${STAGING_ROOT}"
chmod 0700 "${STAGING_ROOT}"
# Clean only abandoned private scratch artifacts, never remote backups.
find "${STAGING_ROOT}" -maxdepth 1 -name 'antiek-backup.*' -mtime +2 -exec rm -rf -- {} +
readonly STAGING="$(mktemp -d "${STAGING_ROOT%/}/antiek-backup.XXXXXXXX")"
readonly ARCHIVE="${STAGING}.tar.gz"
# Portable UTC ISO stamp (+%Y-%m-%dT%H:%M:%SZ): GNU date's --iso-8601 is not
# portable to the BSD date the test harness may run under; output for UTC is
# equivalent.
readonly LOG_PREFIX="[$(date -u +%Y-%m-%dT%H:%M:%SZ)]"
readonly SCRIPT_VERSION="backup.sh/2026-07-11.verify-gate-3"
readonly REMOTE="r2:${BUCKET}/nightly/antiek-${TIMESTAMP}.tar.gz"

echo "${LOG_PREFIX} backup starting → ${REMOTE}"

# Always clean staging on exit, even if something below fails. Prevents
# the staging root filling up if a partial backup is left behind.
cleanup() {
    rm -rf "${STAGING}" "${ARCHIVE}"
}
trap cleanup EXIT

# DuckDB EXPORT below runs as the antiek user (file ownership of
# the snapshot matches the substrate's process); the staging dir
# was created by root and antiek can't write into it without an
# explicit chown. Chowning is cheaper than restructuring the
# privilege model. Cleanup trap above still removes regardless of
# owner. Fixed 2026-05-18 — was silently making nightly backups
# fail at the EXPORT step before the timer ever fired.
chown antiek:antiek "${STAGING}"

# EXPORT, verification, and compression coexist briefly. Refuse before taking
# the writer lock when the local filesystem cannot hold that working set.
readonly DB_KIB="$(du -k "${STATE_DIR}/antiek.duckdb" | cut -f1)"
readonly AVAILABLE_KIB="$(df -Pk "${STAGING_ROOT}" | awk 'NR==2 {print $4}')"
readonly REQUIRED_KIB="$((DB_KIB * 4 + 262144))"
if (( AVAILABLE_KIB < REQUIRED_KIB )); then
    echo "ERROR: backup: insufficient scratch space (available=${AVAILABLE_KIB}KiB required=${REQUIRED_KIB}KiB)" >&2
    exit 8
fi

# ── 1. DuckDB consistent snapshot (under the single-writer flock) ─────────
# Run as the antiek user so file ownership matches — and, critically, so the
# sidecar lock file is created/opened as the same user the substrate's
# runtime/db_lock.py uses (a root-owned 0600 lock file would break the
# service's own lock acquisition). DuckDB CLI isn't in Ubuntu's apt repos as
# of 24.04, so we use the substrate's own venv — the duckdb Python package
# is pinned in pyproject.toml and works headless.
#
# The heredoc mirrors runtime/db_lock.py's flock protocol (same lock path
# <db>.write.lock, exclusive LOCK_EX acquired non-blocking in a poll loop
# with a deadline, pid + purpose stamped into the file) instead of importing
# runtime.db_lock, because (a) a stdin heredoc run from cron has no repo
# root on sys.path — the normalize step below already loads tools/ by file
# path for exactly this reason; and (b) db_lock.connect_write opens the DB
# for WRITE (and imports runtime.test_store_guard) — the backup must hold
# the writers' lock while opening READ-ONLY, a mode connect_write does not
# offer. Same lock file + same flock semantics ⇒ mutual exclusion with
# antiek.service and antiek-continuous-research.service is preserved.
# Lock window is minimal: connect + EXPORT + count capture only; normalize,
# verify, tar, and upload all run after release.
echo "${LOG_PREFIX} exporting DuckDB → ${STAGING}/duckdb (single-writer flock, timeout ${LOCK_TIMEOUT_S}s)"
sudo -u {{ antiek_user }} {{ antiek_install_dir }}/.venv/bin/python3 - <<PY
import errno
import fcntl
import json
import os
import sys
import time

import duckdb

db_path = "${STATE_DIR}/antiek.duckdb"
lock_path = db_path + ".write.lock"  # runtime/db_lock.py: _lock_path_for()
timeout_s = float("${LOCK_TIMEOUT_S}")

fd = os.open(lock_path, os.O_CREAT | os.O_WRONLY, 0o600)
deadline = time.monotonic() + timeout_s
while True:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except OSError as e:
        if e.errno not in (errno.EWOULDBLOCK, errno.EAGAIN):
            raise
        if time.monotonic() >= deadline:
            os.close(fd)
            sys.stderr.write(
                f"ERROR: backup: could not acquire DuckDB write lock {lock_path} "
                f"within {timeout_s:.0f}s - another writer is holding it; "
                "aborting backup (nothing exported, nothing uploaded)\n"
            )
            sys.exit(3)
        time.sleep(0.25)
try:
    # Stamp pid + purpose + ISO timestamp, same diagnostics convention as
    # runtime/db_lock.py (best-effort).
    try:
        os.ftruncate(fd, 0)
        stamp = "%d nightly_backup %s\n" % (
            os.getpid(), time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
        os.write(fd, stamp.encode())
    except OSError:
        pass
    con = duckdb.connect(db_path, read_only=True)
    try:
        # Count capture happens on the SAME connection inside the SAME lock
        # window as the EXPORT, so the counts are exactly the snapshot's.
        # Captured BEFORE the EXPORT so the all-empty refusal below aborts
        # without wasting export effort.
        con.execute("BEGIN TRANSACTION")
        tables = [row[0] for row in con.execute(
            "SELECT table_name FROM information_schema.tables "
            "WHERE table_schema = 'main' AND table_type = 'BASE TABLE' "
            "ORDER BY table_name"
        ).fetchall()]
        def quoted(name):
            return '"' + name.replace('"', '""') + '"'
        counts = {
            t: con.execute(f"SELECT COUNT(*) FROM {quoted(t)}").fetchone()[0]
            for t in tables
        }
        columns = con.execute(
            "SELECT table_name, column_name, ordinal_position, column_default, "
            "is_nullable, data_type FROM information_schema.columns "
            "WHERE table_schema = 'main' ORDER BY table_name, ordinal_position"
        ).fetchall()
        # DuckDB EXPORT currently omits self-referential foreign keys; the
        # normalizer below repairs the malformed comma it leaves behind. Track
        # every constraint the export format can represent and fail if any of
        # those disappear. The excluded known limitation remains explicit.
        constraints = con.execute(
            "SELECT table_name, constraint_type, constraint_text, "
            "constraint_column_names, referenced_table, referenced_column_names "
            "FROM duckdb_constraints() WHERE schema_name = 'main' "
            "AND NOT (constraint_type = 'FOREIGN KEY' AND referenced_table = table_name) "
            "ORDER BY table_name, constraint_type, constraint_text, constraint_column_names"
        ).fetchall()
        indexes = con.execute(
            "SELECT index_name, table_name, is_unique, is_primary, expressions, sql "
            "FROM duckdb_indexes() WHERE schema_name = 'main' "
            "ORDER BY table_name, index_name"
        ).fetchall()
        # Fail closed on logical truncation: an all-empty source would
        # count-match its own empty export, pass the verify gate, upload,
        # and stamp a fresh marker — certifying data loss as a good backup.
        core_counts = {name: counts.get(name, 0) for name in ("documents", "chunks", "nodes")}
        if "${ALLOW_EMPTY}" != "1" and all(v == 0 for v in core_counts.values()):
            sys.stderr.write(
                "ERROR: backup: all core tables empty (documents=0, chunks=0, "
                "nodes=0) - refusing to certify an empty backup of a "
                "production store; set ANTIEK_BACKUP_ALLOW_EMPTY=1 for a "
                "legitimately empty install (nothing exported, nothing "
                "uploaded)\n"
            )
            sys.exit(5)
        con.execute("EXPORT DATABASE '${STAGING}/duckdb' (FORMAT PARQUET);")
        con.execute("COMMIT")
    finally:
        con.close()
finally:
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)

manifest = {
    "counts": counts,
    "columns": columns,
    "constraints": constraints,
    "indexes": indexes,
    "duckdb_version": duckdb.__version__,
}
with open("${STAGING}/source_manifest.json", "w") as f:
    json.dump(manifest, f, indent=2)
print(f"  source row counts: {counts}")
PY

# ── 1b. Normalize EXPORT schema.sql (DuckDB self-ref-FK stray-comma bug) ──
# DuckDB EXPORT drops a self-referential FK but leaves a stray comma in
# schema.sql, which makes the inverse IMPORT DATABASE raise
# "syntax error at or near ','" on the real schema (edges.superseded_by,
# deliverable_sections.parent_section_id). The documented DR restore
# (runbooks/disaster-recovery.md) IS IMPORT DATABASE, so without this step
# the nightly backup is non-restorable. The normalizer is depth/string-
# aware and only removes commas that are never valid inside CREATE TABLE
# (see specs/antiek-data-durability + tests/test_backup_normalize_schema.py).
# Loaded by file path so the backup does not depend on the tools/ package
# layout or import-time side effects.
echo "${LOG_PREFIX} normalizing EXPORT schema.sql (self-ref-FK stray-comma fix)"
sudo -u {{ antiek_user }} {{ antiek_install_dir }}/.venv/bin/python3 - <<PY
import importlib.util
_p = "{{ antiek_install_dir }}/tools/backup_normalize_schema.py"
_spec = importlib.util.spec_from_file_location("backup_normalize_schema", _p)
_mod = importlib.util.module_from_spec(_spec); _spec.loader.exec_module(_mod)
_s = "${STAGING}/duckdb/schema.sql"
with open(_s) as _f: _raw = _f.read()
_fixed = _mod.normalize_exported_schema_sql(_raw)
if _fixed != _raw:
    with open(_s, "w") as _f: _f.write(_fixed)
    print("  schema.sql normalized (stray commas removed)")
else:
    print("  schema.sql already clean (no-op)")
PY

# ── 1c. Verify the export BEFORE anything is uploaded (R1 gate) ───────────
# IMPORT the normalized export into a scratch DuckDB inside the staging dir
# and require every table/count plus the representable columns, constraints,
# and indexes to match the source captured at EXPORT time. Any failure → non-zero exit here,
# and set -e guarantees the rclone upload below never runs. The scratch DB
# is removed on success so it never bloats the archive; source_manifest.json
# stays in staging deliberately (the archive carries its own manifest).
echo "${LOG_PREFIX} verifying export (IMPORT into scratch DB + row-count match) — gate before upload"
sudo -u {{ antiek_user }} {{ antiek_install_dir }}/.venv/bin/python3 - <<PY
import json
import os
import sys

import duckdb

with open("${STAGING}/source_manifest.json") as f:
    manifest = json.load(f)
expected = manifest["counts"]

scratch = "${STAGING}/verify-scratch.duckdb"
try:
    con = duckdb.connect(scratch)
    try:
        con.execute("IMPORT DATABASE '${STAGING}/duckdb'")
        def quoted(name):
            return '"' + name.replace('"', '""') + '"'
        imported_tables = [row[0] for row in con.execute(
            "SELECT table_name FROM information_schema.tables "
            "WHERE table_schema = 'main' AND table_type = 'BASE TABLE' "
            "ORDER BY table_name"
        ).fetchall()]
        if imported_tables != sorted(expected):
            raise RuntimeError(
                f"table manifest mismatch: source={sorted(expected)} "
                f"imported={imported_tables}"
            )
        actual = {
            t: con.execute(f"SELECT COUNT(*) FROM {quoted(t)}").fetchone()[0]
            for t in imported_tables
        }
        actual_columns = con.execute(
            "SELECT table_name, column_name, ordinal_position, column_default, "
            "is_nullable, data_type FROM information_schema.columns "
            "WHERE table_schema = 'main' ORDER BY table_name, ordinal_position"
        ).fetchall()
        actual_constraints = con.execute(
            "SELECT table_name, constraint_type, constraint_text, "
            "constraint_column_names, referenced_table, referenced_column_names "
            "FROM duckdb_constraints() WHERE schema_name = 'main' "
            "AND NOT (constraint_type = 'FOREIGN KEY' AND referenced_table = table_name) "
            "ORDER BY table_name, constraint_type, constraint_text, constraint_column_names"
        ).fetchall()
        actual_indexes = con.execute(
            "SELECT index_name, table_name, is_unique, is_primary, expressions, sql "
            "FROM duckdb_indexes() WHERE schema_name = 'main' "
            "ORDER BY table_name, index_name"
        ).fetchall()
    finally:
        con.close()
except Exception as e:
    sys.stderr.write(
        "ERROR: backup verify FAILED - export does not IMPORT cleanly "
        f"({type(e).__name__}: {e}); upload blocked\n"
    )
    sys.exit(4)

mismatches = {t: [expected[t], actual[t]] for t in expected if actual[t] != expected[t]}
if mismatches:
    sys.stderr.write(
        "ERROR: backup verify FAILED - row-count mismatch source vs import "
        f"(table: [source, imported]): {mismatches}; upload blocked\n"
    )
    sys.exit(4)

def json_shape(value):
    """Canonicalize DuckDB tuples to the JSON array shape stored on disk."""
    return json.loads(json.dumps(value))

catalog_mismatches = {
    name: {"source": manifest[name], "imported": value}
    for name, value in (
        ("columns", actual_columns),
        ("constraints", actual_constraints),
        ("indexes", actual_indexes),
    )
    if manifest[name] != json_shape(value)
}
if catalog_mismatches:
    sys.stderr.write(
        "ERROR: backup verify FAILED - restored catalog differs from source "
        f"(columns/constraints/indexes): {catalog_mismatches}; upload blocked\n"
    )
    sys.exit(4)

for leftover in (scratch, scratch + ".wal"):
    if os.path.exists(leftover):
        os.remove(leftover)
print(f"  verify OK - import succeeded, row counts match: {actual}")
PY

# ── 2. Event log (append-only, safe to rsync live) ────────────────────────
if [[ -d "${STATE_DIR}/research_events" ]]; then
    echo "${LOG_PREFIX} rsync event log"
    rsync -a "${STATE_DIR}/research_events/" "${STAGING}/research_events/"
else
    echo "${LOG_PREFIX} no event log directory yet; skipping"
fi

# ── 3. Knowledge skills (Phase 8 auto-patches accumulate here) ────────────
if [[ -d "${STATE_DIR}/knowledge_skills" ]]; then
    echo "${LOG_PREFIX} rsync knowledge_skills"
    rsync -a "${STATE_DIR}/knowledge_skills/" "${STAGING}/knowledge_skills/"
else
    echo "${LOG_PREFIX} no knowledge_skills directory yet; skipping"
fi

# ── 4. Compress + upload ──────────────────────────────────────────────────
echo "${LOG_PREFIX} tar+gzip"
tar -czf "${ARCHIVE}" -C "${STAGING_ROOT}" "$(basename "${STAGING}")"

readonly ARCHIVE_SIZE_HUMAN="$(du -h "${ARCHIVE}" | cut -f1)"
echo "${LOG_PREFIX} archive size: ${ARCHIVE_SIZE_HUMAN}"

echo "${LOG_PREFIX} uploading to R2"
rclone copyto "${ARCHIVE}" "${REMOTE}" \
    --config /etc/rclone/rclone.conf
readonly ARCHIVE_SHA256="$(sha256sum "${ARCHIVE}" | cut -d' ' -f1)"

# ── 5. Remote verification ────────────────────────────────────────────────
# Download-and-compare the just-uploaded object. A successful copy command is
# not durable evidence that the remote bytes are readable and identical.
# Retention is intentionally NOT performed here: wall-clock skew on a host
# must never be able to delete the last known-good backup. Configure an R2
# lifecycle policy (and bucket versioning where available) independently.
echo "${LOG_PREFIX} verifying uploaded object by read-back"
readonly REMOTE_SHA256="$(rclone hashsum SHA-256 "${REMOTE}" \
    --download \
    --config /etc/rclone/rclone.conf | awk 'NR == 1 {print $1}')"
if [[ ! "${REMOTE_SHA256}" =~ ^[0-9a-f]{64}$ ]] || [[ "${REMOTE_SHA256}" != "${ARCHIVE_SHA256}" ]]; then
    echo "ERROR: backup: remote read-back SHA-256 mismatch; refusing freshness marker" >&2
    exit 9
fi

# ── 6. Freshness marker (only reachable on full success) ──────────────────
# tools/backup_freshness.py reads this marker; a marker older than its
# threshold (default 26h) — or missing — means nightly backups stopped
# landing. Written atomically by root after remote read-back succeeds.
readonly MARKER_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "${LOG_PREFIX} writing freshness marker → ${STATE_DIR}/backup_freshness.json"
{{ antiek_install_dir }}/.venv/bin/python3 - <<PY
import json
import os

with open("${STAGING}/source_manifest.json") as f:
    counts = json.load(f)["counts"]
marker = {
    "completed_at": "${MARKER_TS}",
    "archive": "antiek-${TIMESTAMP}.tar.gz",
    "remote": "${REMOTE}",
    "sha256": "${ARCHIVE_SHA256}",
    "counts": counts,
    "script_version": "${SCRIPT_VERSION}",
}
tmp = "${STATE_DIR}/backup_freshness.json.tmp"
with open(tmp, "w") as f:
    json.dump(marker, f, indent=2)
    f.write("\n")
os.replace(tmp, "${STATE_DIR}/backup_freshness.json")
print("  marker written")
PY

echo "${LOG_PREFIX} backup complete"
