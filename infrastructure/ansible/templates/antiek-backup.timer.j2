# Ansible managed.
#
# Nightly trigger for antiek-backup.service.

[Unit]
Description=Antiek nightly backup timer ({{ backup_cron_hour }}:{{ backup_cron_minute }} UTC)
Documentation=https://github.com/Slimydog21/Antiek

[Timer]
# Fire at the configured UTC time daily. Persistent=true ensures a missed run
# (VM down at the scheduled time) fires on next boot rather than
# being silently skipped.
OnCalendar=*-*-* {{ backup_cron_hour }}:{{ backup_cron_minute }}:00 UTC
Persistent=true
Unit=antiek-backup.service

[Install]
WantedBy=timers.target
