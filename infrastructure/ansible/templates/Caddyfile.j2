# {{ ansible_managed }}
#
# Caddy reverse proxy in front of uvicorn + static SPA for the
# redesigned reading app (apps/reading).
#
# Routing:
#   /<api-prefix>/*  → reverse_proxy uvicorn (40 prefixes enumerated below)
#   else             → file_server {{ frontend_dist_dir }} with SPA fallback
#
# Why Caddy not nginx?
#   1. Automatic Let's Encrypt — no certbot, no cron renewal job, no
#      ACME-challenge plumbing.
#   2. Sane default timeouts (long enough to not break 10-minute LLM
#      calls without explicit overrides — though we set them explicitly
#      below for documentation).
#   3. WebSocket support is automatic on `upgrade` requests; no special
#      `proxy_pass` config like nginx demands.
#   4. One file, mostly self-explanatory; nginx config blocks are dense.
#
# The TLS cert is provisioned on first request to https://api.antiek.ai
# via ACME HTTP-01 (port 80). UFW must allow ports 80 AND 443 (setup.yml
# does this). Cloudflare DNS for api.antiek.ai is NOT proxied (grey
# cloud) so the ACME challenge hits Caddy directly.

{{ api_domain }} {
    # ── 1. API prefixes (reverse-proxied to uvicorn) ──────────────────
    # The list was extracted from every `@app.X("/foo")` decorator in
    # interfaces/research/api/*.py (40 top-level prefixes as of this
    # commit). When the substrate gains a new top-level route, add it
    # here + redeploy.
    # NOTE: keep the @api_routes path list on ONE LINE — Caddy's
    # tokenizer for `path` matcher arguments doesn't honor backslash
    # continuation (the backslash gets treated as a literal token,
    # breaking the matcher silently — `caddy validate` accepts the
    # malformed result + every request falls through to uvicorn).
    @api_routes path /.well-known/* /ad-impressions* /ad-inventory* /advertisers* /ai/* /attribution* /auth/* /backtest* /billing* /blocks/* /campaigns* /chunks* /creator-payouts* /cross-graph/* /deliverables* /documents* /events/* /federation* /health /interview-projects* /interviews* /investigations* /loop-3/* /notebooks* /ops/* /outcomes* /payouts* /publishers* /quality-gate* /sections* /skill-rules* /sources* /stats* /thought-partner /trajectory/* /trust-center* /voice/* /voice-notes* /watch-for-later* /ws/*

    handle @api_routes {
        # Long-running LLM dispatches can stay open for 600+ seconds.
        # The 900s window matches the systemd unit's
        # --timeout-keep-alive. Without this Caddy's default ~30s
        # timeout would 504 mid-call.
        reverse_proxy localhost:{{ uvicorn_port }} {
            transport http {
                read_timeout 900s
                write_timeout 900s
                dial_timeout 30s
            }
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # WebSockets: Caddy auto-detects `Upgrade: websocket` and proxies
    # them indefinitely. The substrate's /ws/events endpoint needs this
    # for the live event tail to work. The /ws/* prefix is in
    # @api_routes above; no further config needed.

    # ── 2. Frontend SPA (default handle) ──────────────────────────────
    # The redesigned reading app is built with Vite to static HTML+JS
    # +CSS in apps/reading/dist, then rsynced to {{ frontend_dist_dir }}.
    #
    # try_files makes React Router work: /wrestle/<doc> or /inv/<id>
    # don't exist on disk, but Caddy serves index.html for any miss
    # and the client routes from there.
    handle {
        root * {{ frontend_dist_dir }}
        try_files {path} /index.html
        file_server

        # Hashed bundle files (`*-AbCd123.js`) are content-addressed —
        # Vite changes the hash on every change, so cache forever.
        @hashed_assets path_regexp ^/assets/.+-[A-Za-z0-9_-]{6,}\.(js|css|woff2?|png|svg|jpg|webp)$
        header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

        # index.html must never cache long — operators see new builds
        # on every reload.
        @html path /index.html /
        header @html Cache-Control "no-store, must-revalidate"
    }

    # ── 3. Cross-cutting ──────────────────────────────────────────────
    # Compress text / JSON / static responses on the fly.
    encode gzip zstd

    # Structured access logs to a rotating file. Keep ~5 weeks of logs;
    # `journalctl` has the application logs separately.
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }

    # Security headers. Not exhaustive — add full CSP once the SPA's
    # CSP surface is stable.
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }
}
