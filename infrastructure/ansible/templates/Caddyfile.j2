# {{ ansible_managed }}
#
# Caddy reverse proxy in front of uvicorn + static SPA for the
# redesigned reading app (apps/reading).
#
# Routing (all of it happens on loopback — see topology below):
#   /<api-prefix>/*  → reverse_proxy uvicorn (40 prefixes enumerated below)
#   else             → file_server {{ frontend_dist_dir }} with SPA fallback
#
# Topology (mirrors cloudflared-config.yml.j2):
#   Cloudflare edge — terminates public TLS; api.antiek.ai is a
#     PROXIED DNS record
#         │
#         ▼ cloudflared tunnel — outbound-only from this box; the box
#           answers on neither 80 nor 443 from the internet
#   127.0.0.1:443 — Caddy. The tunnel dials loopback, and its
#     originRequest sets originServerName: api.antiek.ai and
#     noTLSVerify: true. This site block has no `bind`, so Caddy itself
#     listens on every interface; UFW, not the bind address, is what
#     keeps 80/443 unreachable from the internet.
#         ├─ /<api-prefix>/*  → 127.0.0.1:8001 (uvicorn)
#         └─ everything else  → {{ frontend_dist_dir }} (SPA)
#
#   UFW (setup.yml §3) allows 22 only; 80/443 are closed.
#
# ORIGIN CERT STORY — UNRESOLVED. This file still has no `tls`
# directive, so Caddy defaults to automatic ACME for api.antiek.ai.
# That cannot succeed here: a box the internet cannot reach cannot
# complete validation — neither the port-80 ACME challenge nor
# TLS-ALPN-01 can be answered while 80/443 stay closed behind the
# proxied record. And because the tunnel connects with noTLSVerify, an
# expired origin cert would keep serving silently. Resolution is
# SPR-09 task 9 (~/specs/antiek-v1-connect/SPR-09-infra-scale.md); the
# decision will be recorded in docs/decisions/caddy-cert-strategy-2026-09-20.md
# after the operator captures `caddy list-certificates` on the box.
# Until then nothing about the certificate mechanism changes here.
#
# Why Caddy not nginx?
#   1. Path routing API-vs-SPA on loopback: one `route` block sends the
#      API prefixes to uvicorn and everything else to the SPA
#      file_server with fallback — the job Caddy actually does behind
#      the tunnel.
#   2. Sane default timeouts (long enough to not break 10-minute LLM
#      calls without explicit overrides — though we set them explicitly
#      below for documentation).
#   3. WebSocket support is automatic on `upgrade` requests; no special
#      `proxy_pass` config like nginx demands.
#   4. One file, mostly self-explanatory; nginx config blocks are dense.

{{ api_domain }} {
    # ── Path-based routing via `route` ────────────────────────────────
    # `route` preserves the order of inner directives; without it,
    # Caddy reorders by global default (file_server runs LAST,
    # reverse_proxy runs early). Inside `route`, the first matching
    # directive wins.
    #
    # Strategy:
    #   1. If the path is a known API prefix → reverse_proxy uvicorn.
#   2. Else → serve from {{ frontend_dist_dir }} with SPA fallback.
    #
    # The API prefix list comes from every `@app.X("/foo")` decorator
    # in interfaces/research/api/*.py (47 top-level prefixes). A route
    # missing from this list is served the SPA HTML instead of proxying
    # to uvicorn — which silently breaks that API in prod. This list had
    # DRIFTED (it was missing /books /coordination /corpus /meta-readings
    # /speech, plus the SPR-09 /library + /api/ad/*); the drift is now
    # CI-guarded by tests/test_caddy_allowlist_coverage.py, which fails
    # if any registered route prefix is absent here. Keep this list
    # ONE-LINE — Caddy's tokenizer for `path` matcher arguments doesn't
    # honor backslash line continuation.
@api_routes path /account/* /ad-impressions* /ad-inventory* /advertisers* /ai/* /api/* /artifacts/* /attribution* /auth/* /backtest* /billing* /blocks/* /book-acquisition* /books* /campaigns* /chunks* /claims/* /complete /compose-context /coordination* /corpus* /creator-payouts* /cross-graph/* /deliverables* /diligence* /docs* /documents* /events/* /evidence/* /export* /federation* /feedback/* /forks* /health /ingest/* /internal/* /interview-projects* /interviews* /investigations* /krea* /library* /links/* /loop-3/* /meta-readings* /multimedia* /notebooks* /openapi.json /ops/* /outcomes* /payouts* /projects* /publishers* /quality-gate* /reading/* /research/* /sections* /settings* /skill-rules* /sources* /speak/* /speech* /stats* /styles /styles/* /supersession* /syntheses/* /thought-partner /thread/* /trajectory /trajectory/* /trust-center* /twins* /voice-notes* /voice/* /watch-for-later* /.well-known/* /workstations* /write/* /ws/*


    # ~14 paths overlap between backend API + frontend React Router
    # (e.g. /investigations, /notebooks, /billing, /sources). Backend
    # serves JSON; SPA shows a UI page at the same URL. Disambiguate
    # by Accept header: browser top-level navigation includes
    # `text/html`; fetch / XHR / WS / asset loads don't.
    #
    # `/auth/*` is deliberately excluded. Magic-link callbacks ARE browser
    # navigations, but they must reach FastAPI to verify the token and mint the
    # session cookie. Serving index.html for `/auth/callback` leaves the token
    # in the address bar and sends the operator straight back to Login.
    #
    # The machine-readable operational surfaces are excluded for the same
    # reason: they have no SPA route, and must always be the backend's own
    # answer. Each path excluded here also appears in @api_routes below, so
    # the exclusion actually reaches uvicorn instead of falling through to
    # the static file_server.
    #
    # /health matters most. This matcher is the FIRST handler in the route
    # block, so any client sending a browser-like Accept header — which most
    # uptime monitors do — was served index.html with 200 unconditionally,
    # including while uvicorn was down and the JSON path returned 502. A
    # monitor pointed at /health could never observe an outage. Verified
    # 2026-09-19 against production: `curl -H 'Accept: text/html' /health`
    # returned 200 text/html (1308 bytes, the SPA shell), while
    # `Accept: application/json` returned the real 715-byte payload.
    @spa_browser_nav {
        header Accept *text/html*
        not path /auth/* /health /openapi.json /ops/*
    }

    # Named matchers MUST sit at server scope (Caddy rejects @matchers
    # defined inside route/handle). `@static_exists` is the "real file on
    # disk" matcher used by the static-asset handler inside the route.
    @static_exists file {
        # file-matcher `root` is a path, not the root DIRECTIVE (no `*` slot).
        root {{ frontend_dist_dir }}
    }

    route {
        # 1. Browser top-level navigation → SPA, except the auth control plane.
        #    This is what lets typing /investigations/<uuid> in the
        #    address bar load the React route — without this rule
        #    the request matches @api_routes and uvicorn's auth
        #    middleware bounces with 401.
        handle @spa_browser_nav {
            root * {{ frontend_dist_dir }}
            try_files {path} /index.html
            file_server
        }

        # 2. fetch / XHR / WebSocket against an API prefix → uvicorn.
        #    Long-running LLM dispatches can stay open for 600+s;
        #    900s timeouts match the systemd unit's
        #    --timeout-keep-alive.
        reverse_proxy @api_routes localhost:{{ uvicorn_port }} {
            # Deploy-window 502 guard (2026-09-19). During
            # `systemctl restart antiek` the upstream socket is briefly
            # refused; Caddy's default is to fail fast with 502, which
            # clients (e.g. the mac-mini herdr bridge) see as a burst at
            # every deploy. Hold each request and retry the dial for up
            # to 90s instead — the request completes once uvicorn rebinds.
            # Retrying a refused dial is safe for ANY method: the
            # connection never opened, so zero request bytes were sent.
            # 90s covers stop + idempotent migrate + uvicorn boot on a
            # typical deploy; a genuinely dead backend still 502s, just
            # after the try budget instead of instantly.
            lb_try_duration 90s
            lb_try_interval 250ms
            transport http {
                read_timeout 900s
                write_timeout 900s
                dial_timeout 30s
            }
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }

        # 3. Static files that actually exist on disk (hashed bundles,
        #    fonts, /favicon.svg, /mark-*.png) → serve them as-is.
        #    `file` is the matcher, so a miss falls through rather than
        #    being papered over by an index.html fallback.
        handle @static_exists {
            root * {{ frontend_dist_dir }}
            file_server
        }

        # 4. Everything else → JSON 404.
        #
        #    THE SPA-200 DEFECT (verified live 2026-09-26, then fixed here):
        #    `curl https://api.antiek.ai/v1/does-not-exist-xyz` and
        #    `curl https://api.antiek.ai/docs` both returned HTTP 200 with
        #    the SPA's index.html. Unknown API routes were indistinguishable
        #    from success. Root cause was this catch-all: try_files
        #    {path} /index.html rewrote every miss to the SPA shell and
        #    file_server answered 200. Only /api/* and /health reached
        #    uvicorn (via: 1.1 Caddy), so a typo in a client base path
        #    looked healthy.
        #
        #    Now: a request that is not a browser navigation (step 1), not a
        #    registered API route (step 2), and not an existing static file
        #    (step 3) gets an explicit JSON 404. Browser navigations still
        #    reach step 1 and get the SPA shell for client-side routing.
        handle {
            header Content-Type "application/json"
            respond `{"error":{"message":"no such endpoint","path":"{http.request.uri.path}"}}` 404
        }
    }

    # ── Cache-control headers for static assets ───────────────────────
    # Hashed bundles (`*-AbCd123.js`) are content-addressed — Vite
    # changes the hash on every change, so caching for 1 year +
    # immutable is the safe default. The browser-nav rule above
    # already returns index.html for navigation requests; the
    # max-age=0 rule below catches direct loads of index.html (e.g.
    # when reloading inside the SPA shell).
    @hashed_assets path_regexp ^/assets/.+-[A-Za-z0-9_-]{6,}\.(js|css|woff2?|png|svg|jpg|jpeg|webp|gif|ico)$
    header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

    @html path /index.html /
    header @html Cache-Control "no-store, must-revalidate"

    # WebSockets ride /ws/* through @api_routes; Caddy auto-detects
    # Upgrade: websocket and proxies indefinitely.

    # ── 3. Cross-cutting ──────────────────────────────────────────────
    # Compress text / JSON / static responses on the fly.
    encode gzip zstd

    # Structured access logs to a rotating file. Keep ~5 weeks of logs;
    # `journalctl` has the application logs separately. Cloudflare Access
    # service-token headers are deleted at encoding time because Caddy's
    # built-in sensitive-header list does not cover these custom names.
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 720h
        }
        format filter {
            request>headers>Cf-Access-Client-Id delete
            request>headers>Cf-Access-Client-Secret delete
            wrap json
        }
    }

    # Security headers. Verified live 2026-09-26 before this change:
    #   Strict-Transport-Security absent, Content-Security-Policy absent,
    #   Referrer-Policy absent on this host, Permissions-Policy absent.
    #   Matrix was api=0/www=0 for HSTS and CSP; the two hosts disagreed
    #   about which headers exist at all.
    #
    # Full resource CSP (2026-09-27). The 2026-09-26 policy deliberately
    # stopped at frame-ancestors because a wrong resource CSP breaks the
    # app silently; this closes that residual now that every source below
    # is traced to a surface in the shipped bundle (paths in apps/reading).
    # The policy and apps/reading/public/_headers state the same string on
    # both hosts on purpose: the Pages build and the api.antiek.ai copy of
    # the SPA are the same bundle with different env baked in.
    #
    # Why each non-obvious source is here:
    #   script-src posthog hosts: posthog-js is baked into the Pages
    #     bundle when VITE_POSTHOG_PROJECT_TOKEN is set
    #     (src/lib/posthogClient.ts) and talks to its api_host;
    #     *.posthog.com / *.i.posthog.com cover the EU and US hosts named
    #     in docs/decisions/posthog-activation.md.
    #   style-src 'unsafe-inline': React style props (AppShell.tsx,
    #     PanelLayout.tsx, BrainPresence.tsx). fonts.googleapis.com: the
    #     Google Fonts @import in src/modes/LinkMonster/LinkMonster.css.
    #   img-src data:: the Login.css noise texture and the krea scene
    #     placeholders are data: URIs (src/krea/placeholder.ts). https::
    #     AdBorder renders creative_url as <img>, and adFillClient accepts
    #     an absolute https: creative (src/components/ad/adFillClient.ts,
    #     isCreativeUrl).
    #   font-src fonts.gstatic.com: font files behind that same import.
    #   connect-src api.antiek.ai + wss: the Pages host builds with
    #     VITE_API_BASE_URL=https://api.antiek.ai and derives wss:// for
    #     /ws/events (src/hooks/useEventStream.ts, src/modes/Replay);
    #     'self' alone would 404 every API call on that host. The
    #     api.antiek.ai copy of the SPA is same-origin and stays on 'self'.
    #   media-src blob:: ReadAloud plays TTS through
    #     new Audio(URL.createObjectURL(blob))
    #     (src/components/voice/ReadAloud.tsx).
    #   frame-src blob:: style and document previews are
    #     URL.createObjectURL(html) iframes (StyleWheel.tsx,
    #     DocumentStylePreview.tsx). KnowledgePanel's srcDoc iframe is
    #     sandboxed to zero permissions and needs no source.
    #   worker-src 'self': pdfjs ships its worker as a same-origin
    #     /assets/pdf.worker-*.mjs (src/components/PdfViewer.tsx).
    #
    # unsafe-eval is deliberately absent. The only eval-shaped code in the
    # production bundle is pdfjs's isEvalSupported() probe and its
    # PostScriptCompiler; both fall back to the interpreter when the probe
    # throws (checked against the built dist: each site is try/catch
    # guarded), so pdf.js keeps working under this policy.
    #
    # The ArxivFrame embed of arxiv.org is deliberately NOT allowed: the
    # component degrades to its link card when framing fails, and arxiv.org
    # refuses framing anyway (src/modes/Reading/ArxivFrame.tsx).
    #
    # X-Frame-Options above and frame-ancestors here are the same policy
    # stated twice on purpose: XFO for legacy UAs, CSP for modern ones.
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' https://*.posthog.com https://*.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.antiek.ai wss://api.antiek.ai https://*.posthog.com https://*.i.posthog.com; media-src 'self' blob:; worker-src 'self'; frame-src 'self' blob:"
    }
}
