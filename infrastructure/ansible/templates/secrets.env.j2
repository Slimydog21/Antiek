# {{ ansible_managed }}
#
# Antiek runtime secrets. systemd loads this via EnvironmentFile= before
# dropping privileges to the antiek user.
#
# This file is created EMPTY by the Ansible setup playbook. The operator
# fills it in manually via:
#
#     ssh root@<vm-ip> sudoedit /etc/antiek/secrets.env
#
# Mode: 0640, owner root:antiek (group-readable so systemd can load it).
#
# DO NOT commit real values to git. The template here is for shape only;
# the setup playbook's `template` task places it with `force: false`
# (playbooks/setup.yml, "place empty secrets.env"), so a populated file
# is never overwritten on subsequent setup runs.

# OpenRouter — single key drives both DeepSeek (flash/pro) and Claude
# (synthesis) per substrate/dispatch/config.yaml. The bootstrap module
# in substrate/dispatch/providers/bootstrap.py registers the provider
# only if this env var is set.
OPENROUTER_API_KEY=

# Direct provider keys — only needed if you want to bypass OpenRouter
# (lower per-token cost at higher operational complexity). Leave blank
# to route everything through OpenRouter.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ── Krea image generation (living mountain scene) ────────────────────
# Server-side bearer token for api.krea.ai, read ONLY by
# interfaces/research/api/krea_routes.py — the browser never sees it.
# Empty/absent → /krea/* answers the typed 503 fallback ("no_key") and
# the UI keeps its deterministic placeholder; nothing crashes.
# Provisioning / rotation / kill-switch / costs:
# infrastructure/runbooks/krea.md.
KREA_API_TOKEN=

# Optional Krea knobs. Defaults (shown) live in krea_routes.py and are
# conservative; uncomment to override. The process reads them at call
# time, but systemd loads this file at unit start — editing it still
# requires `systemctl restart antiek` to take effect on prod.
# KREA_KILL_SWITCH=          # panic lever: 1/true/yes/on forces fallback for EVERY generation, key-independent (checked before the key)
# ANTIEK_KREA_BASE_URL=      # Krea API base URL (default https://api.krea.ai); override only for proxying or a host change
# ANTIEK_KREA_MODEL_PATH=    # model segment of the submit URL (default bfl/flux-1-dev; e.g. krea/krea-2/medium — changes unit cost, see runbook §7)
# KREA_DAILY_UNIT_CAP=       # max billable submits/day (default 50 ≈ $0.35/day at flux-1-dev's $0.007/request; 0 blocks all)
# KREA_RATE_LIMIT_MAX=       # max submits per 60s window (default 6; caps a runaway loop)
# KREA_POLL_BUDGET_S=        # seconds /krea/scene polls a job before the typed job_timeout fallback (default 30)
# KREA_CACHE_TTL_S=          # scene-art cache TTL seconds (default 3600); identical scene-state within TTL is never re-billed
