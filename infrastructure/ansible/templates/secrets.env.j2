# {{ ansible_managed }}
#
# Antiek runtime secrets. systemd loads this via EnvironmentFile= before
# dropping privileges to the antiek user.
#
# This file is created EMPTY by the Ansible setup playbook. The operator
# fills it in manually via:
#
#     ssh root@<vm-ip> sudoedit /etc/antiek/secrets.env
#
# Mode: 0640, owner root:antiek (group-readable so systemd can load it).
#
# DO NOT commit real values to git. The template here is for shape only;
# Ansible's `copy` task with `force: no` ensures we don't overwrite a
# populated file on subsequent setup runs.
#
# CLAUDE-LESS FOOTPRINT (operator decision 2026-07-06): every dispatch
# tier primary is GLM-5.2 via the z.ai DIRECT API (Z_AI_API_KEY). The
# two cross-family fallbacks are DeepSeek V4 Pro and Xiaomi MiMo V2.5
# Pro, each via its OWN direct API — no OpenRouter hop. The three keys
# below are what a claude-less deploy NEEDS; see
# substrate/dispatch/config.yaml. The bootstrap module
# (substrate/dispatch/providers/bootstrap.py) registers a provider ONLY
# when its key is present, so a missing key silently drops that tier
# primary/fallback rather than bricking the call.

# z.ai — GLM-5.2 direct API. PRIMARY for every tier (flash/pro/verify via
# the `zai` provider; synthesis via `zai_reasoning` with thinking on).
Z_AI_API_KEY=

# DeepSeek V4 Pro — direct API. Tier-2 cross-family fallback (every tier).
DEEPSEEK_API_KEY=

# Xiaomi MiMo V2.5 Pro — direct API. Tier-3 cross-family fallback.
XIAOMI_API_KEY=

# Optional bypass providers — NOT routed by the claude-less config.yaml.
# Leave blank unless you intentionally re-route a tier through them (a
# one-line config edit, never a code change). The Anthropic/OpenRouter
# adapters still ship in substrate/dispatch/providers/ as that escape
# hatch; they simply have no tier pointing at them.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# NotDiamond advisory model-router. Optional; runtime/notdiamond resolves this
# lazily only when ND advisory selection is explicitly called.
NOTDIAMOND_API_KEY=

# Dedicated HMAC key for signed book-acquisition intent, authorization,
# port, and recovery receipts. Generate at least 32 random bytes and encode
# them as a printable value. Never reuse a JWT/session/provider credential.
ANTIEK_BOOK_ACQUISITION_SIGNING_KEY=

# Deep Research gather (Exa Wedge 1) — server-side only. Default stub in code;
# prod DRW requires explicit opt-in:
#   ANTIEK_DRW_GATHER=exa
#   EXA_API_KEY=
#   EXA_DAILY_BUDGET_USD=5
ANTIEK_DRW_GATHER=
EXA_API_KEY=
EXA_DAILY_BUDGET_USD=

# Embeddings for plan persist / promotion funnel. Use hash when
# sentence-transformers/torch fails on the host (RuntimeError on encode);
# semantic search is degraded but DRW + substrate stay up.
# ANTIEK_EMBEDDING_PROVIDER=hash
