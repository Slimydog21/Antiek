<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.antiek.herdr-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/OPERATOR/.local/bin/herdr-bridge</string>
    <string>--config</string>
    <string>/Users/OPERATOR/.config/antiek-herdr-bridge/config.json</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/OPERATOR/Library/Logs/antiek-herdr-bridge.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/OPERATOR/Library/Logs/antiek-herdr-bridge.err.log</string>
</dict>
</plist>
